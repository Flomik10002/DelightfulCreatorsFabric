{
  "type": "create:sequenced_assembly",
  "fabric:load_conditions": [
    {
      "condition": "fabric:all_mods_loaded",
      "values": [
        "create",
        "farmersdelight"
      ]
    }
  ],
  "ingredient": "minecraft:bowl",
  "transitional_item": {
    "id": "delightfulcreators:incomplete_mixed_salad"
  },
  "result": {
    "id": "farmersdelight:mixed_salad"
  },
  "loops": 1,
  "sequence": [
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "#c:foods/leafy_green",
      "result": "$result"
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "minecraft:beetroot",
      "result": "$result"
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "#c:foods/tomato",
      "result": "$result"
    }
  ]
}
