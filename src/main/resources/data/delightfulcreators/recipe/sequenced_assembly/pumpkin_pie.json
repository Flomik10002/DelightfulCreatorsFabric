{
  "type": "create:sequenced_assembly",
  "fabric:load_conditions": [
    {
      "condition": "fabric:all_mods_loaded",
      "values": [
        "create",
        "farmersdelight"
      ]
    }
  ],
  "ingredient": "farmersdelight:pie_crust",
  "transitional_item": {
    "id": "delightfulcreators:incomplete_pumpkin_pie"
  },
  "result": {
    "id": "minecraft:pumpkin_pie"
  },
  "loops": 2,
  "sequence": [
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "farmersdelight:pumpkin_slice",
      "result": "$result"
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "farmersdelight:pumpkin_slice",
      "result": "$result"
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "minecraft:sugar",
      "result": "$result"
    }
  ]
}
