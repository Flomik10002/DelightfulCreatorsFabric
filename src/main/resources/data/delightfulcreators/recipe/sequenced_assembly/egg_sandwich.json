{
  "type": "create:sequenced_assembly",
  "fabric:load_conditions": [
    {
      "condition": "fabric:all_mods_loaded",
      "values": [
        "create",
        "farmersdelight"
      ]
    }
  ],
  "ingredient": "minecraft:bread",
  "transitional_item": {
    "id": "delightfulcreators:incomplete_egg_sandwich"
  },
  "result": {
    "id": "farmersdelight:egg_sandwich"
  },
  "loops": 2,
  "sequence": [
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "farmersdelight:fried_egg",
      "result": "$result"
    }
  ]
}
