{
  "type": "create:sequenced_assembly",
  "fabric:load_conditions": [
    {
      "condition": "fabric:all_mods_loaded",
      "values": [
        "create",
        "farmersdelight"
      ]
    }
  ],
  "ingredient": "minecraft:bowl",
  "transitional_item": {
    "id": "delightfulcreators:incomplete_roast_chicken"
  },
  "result": {
    "id": "farmersdelight:roast_chicken_block"
  },
  "loops": 1,
  "sequence": [
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "minecraft:cooked_chicken",
      "result": "$result"
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "minecraft:baked_potato",
      "result": "$result"
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "minecraft:carrot",
      "result": "$result"
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "farmersdelight:onion",
      "result": "$result"
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "#c:eggs",
      "result": "$result"
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "minecraft:bread",
      "result": "$result"
    }
  ]
}
