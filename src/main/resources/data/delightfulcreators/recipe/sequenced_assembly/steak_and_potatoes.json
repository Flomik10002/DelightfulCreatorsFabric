{
  "type": "create:sequenced_assembly",
  "fabric:load_conditions": [
    {
      "condition": "fabric:all_mods_loaded",
      "values": [
        "create",
        "farmersdelight"
      ]
    }
  ],
  "ingredient": "farmersdelight:cooked_rice",
  "transitional_item": {
    "id": "delightfulcreators:incomplete_steak_and_potatoes"
  },
  "result": {
    "id": "farmersdelight:steak_and_potatoes"
  },
  "loops": 1,
  "sequence": [
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "minecraft:cooked_beef",
      "result": "$result"
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "minecraft:baked_potato",
      "result": "$result"
    },
    {
      "type": "create:deploying",
      "target": "$ingredient",
      "ingredient": "#c:foods/onion",
      "result": "$result"
    }
  ]
}
